# Local development only. Copy to .env with `pnpm setup`.
# No WhatsApp or AI credentials are needed for the foundation skeleton.
API_HOST=127.0.0.1
API_PORT=3001
WORKER_HOST=127.0.0.1
WORKER_PORT=3002
WEB_HOST=127.0.0.1
WEB_PORT=3000
NEXT_TELEMETRY_DISABLED=1
# Explicit FE-only demo. No real accounts, tokens, API or database involved.
# Set to unconfigured to disable demo sign-in. Rebuild after changing public env.
NEXT_PUBLIC_AUTH_MODE=demo

# Loopback-only Docker Compose services. Example credentials are not production secrets.
POSTGRES_USER=wachatbot
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=wachatbot
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://wachatbot:local_dev_only@127.0.0.1:5432/wachatbot
REDIS_URL=redis://127.0.0.1:6379
