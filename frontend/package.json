{
  "name": "@wachatbot/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ../scripts/run-next.mjs dev",
    "build": "node ../scripts/run-next.mjs build",
    "start": "node ../scripts/run-next.mjs start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "node ../scripts/run-next.mjs typegen && tsc --noEmit",
    "test:e2e": "playwright test && playwright test --config playwright.unconfigured.config.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@next/eslint-plugin-next": "16.3.6"
  }
}
